---
import "katex/dist/katex.min.css";
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ReadingTools from "@/components/ReadingTools.astro";
import config from "@/config";
interface Props {
  title: string;
  description: string;
  date: Date;
  section: string;
  headings: MarkdownHeading[];
}
const { title, description, date, section, headings } = Astro.props;
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { name: "Home", item: config.site.url },
    { name: section, item: new URL(section, config.site.url).href },
    { name: title, item: new URL(Astro.url.pathname, config.site.url).href },
  ].map((v, i) => ({ "@type": "ListItem", position: i + 1, ...v })),
};
---

<Layout title={`${title} | ${config.site.title}`} {description}
  ><script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbs).replace(/</g, "\u003c")}
  /><Header /><main id="main-content" class="site-width" tabindex="-1">
    <div class="reading" data-pagefind-body>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a> /</li><li>
            <a href={`/${section}`}>{section}</a> /
          </li><li aria-current="page">{title}</li>
        </ol>
      </nav><header class="page-heading">
        <h1>{title}</h1><p>{description}</p><p style="font-size:14px">
          Updated <time datetime={date.toISOString()}
            >{date.toLocaleDateString("en-GB", { timeZone: "UTC" })}</time>
        </p>
      </header><slot name="meta" /><slot name="links" /><TableOfContents
        {headings}
      /><article class="app-prose"><slot /></article>
    </div>
  </main><ReadingTools /><Footer /></Layout
>
