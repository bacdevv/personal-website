---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { profile } from "@/site";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const allPosts = getSortedPosts(await getCollection("posts"));
const featuredPosts = allPosts.filter(({ data }) => data.featured);
const recentPosts = allPosts.filter(({ data }) => !data.featured);
const projects = (await getCollection("projects", ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout my-1" tabindex="-1" data-pagefind-body>
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hello, I'm {profile.name}.
      </h1>
      <a href="/rss.xml" class="ml-2 inline-block align-middle" title="RSS Feed" aria-label="RSS Feed">
        <IconRss width={20} height={20} class="stroke-accent inline-block scale-125 stroke-3" />
      </a>
      <p class="mb-2">{profile.bio}</p>
      <p class="mt-2">
        I write about programming, AI/ML, what I'm building, and what I'm learning.
        Take a look at my <a class="simple-link" href="/projects">projects</a> or <a class="simple-link" href="/about">about page</a>.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-muted-foreground">Social Links:</span>
        <Socials />
      </div>
    </section>

    {featuredPosts.length > 0 && (
      <section id="featured" class:list={["pt-12 pb-6", { "border-border border-b": recentPosts.length > 0 }]}>
        <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
        <ul>{featuredPosts.map(post => <Card variant="h3" {...post} />)}</ul>
      </section>
    )}

    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-12 pb-6">
        <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
        <ul>{recentPosts.slice(0, config.posts.perIndex).map(post => <Card variant="h3" {...post} />)}</ul>
      </section>
    )}

    <div class="my-8 text-center">
      <a class="text-accent inline-flex items-center gap-1 font-medium hover:underline decoration-dashed underline-offset-4" href="/blog">
        All Posts <IconArrowRight class="inline-block" />
      </a>
    </div>

    <section class="border-border border-t pt-10 pb-4" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="text-2xl font-semibold tracking-wide">Projects</h2>
      <p class="text-muted-foreground mt-2">Selected software and research projects.</p>
      <ul>
        {projects.map(project => (
          <li class="my-6">
            <a class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline" href={`/projects/${project.id}`}>{project.data.title}</a>
            <p class="text-muted-foreground mt-1 text-sm">{project.data.description}</p>
          </li>
        ))}
      </ul>
      <a href="/projects" class="simple-link text-sm">All projects →</a>
    </section>

    <section class="border-border border-t mt-8 pt-10 pb-12" aria-labelledby="explore-heading">
      <h2 id="explore-heading" class="text-2xl font-semibold tracking-wide">Explore more</h2>
      <ul class="mt-5 space-y-3">
        <li><a href="/notes" class="simple-link">Learning Notes</a> — notes on computer science, math and AI.</li>
        <li><a href="/research" class="simple-link">Research Journal</a> — person re-identification experiments and ideas.</li>
        <li><a href="/contact" class="simple-link">Contact</a> — find ways to get in touch.</li>
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
