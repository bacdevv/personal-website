---
import { getCollection, render } from "astro:content";
import ContentPage from "@/layouts/ContentPage.astro";
import LinearAlgebraLab from "@/components/LinearAlgebraLab.astro";
import MatrixRankLab from "@/components/MatrixRankLab.astro";
export async function getStaticPaths() {
  return (
    await getCollection(
      "notes",
      ({ data }) => !data.draft && data.subject === "Linear Algebra" && data.tags.includes("linear-algebra") && data.date.getTime() <= Date.now()
    )
  ).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const chapter = (["vectors", "matrices", "matrix-multiplication"] as const).find(id => id === entry.id);
---

<ContentPage
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.updated || entry.data.date}
  section="notes"
  {headings}
>
  {chapter && <LinearAlgebraLab slot="lab" chapter={chapter} />}
  {entry.id === "matrix-rank" && <MatrixRankLab slot="lab" />}
  <Content /></ContentPage
>
