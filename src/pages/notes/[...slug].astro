---
import { getCollection, render } from "astro:content";
import ContentPage from "@/layouts/ContentPage.astro";
import LinearAlgebraLab from "@/components/LinearAlgebraLab.astro";
import MatrixRankLab from "@/components/MatrixRankLab.astro";
import CourseLab from "@/components/CourseLab.astro";
import EnglishLiveDemo from "@/components/english/EnglishLiveDemo.astro";
import EnglishStage2LiveDemo from "@/components/english/EnglishStage2LiveDemo.astro";
export async function getStaticPaths() {
  return (
    await getCollection(
      "notes",
      ({ data }) => !data.draft && data.date.getTime() <= Date.now()
    )
  ).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const chapter = (["vectors", "matrices", "matrix-multiplication"] as const).find(id => id === entry.id);
const courseModes: Record<string, string> = {"matrix-spaces":"spaces","solving-systems":"systems","matrix-determinant":"determinant","matrix-inverse":"inverse","projections-orthogonalization":"projection","least-squares":"least-squares","eigendecomposition":"eigen","singular-value-decomposition":"svd","quadratic-forms":"quadratic"};
---

<ContentPage
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.updated || entry.data.date}
  section="notes"
  {headings}
>
  {entry.id === "english-stage-1" && <EnglishLiveDemo slot="lab" />}
  {entry.id === "english-stage-2" && <EnglishStage2LiveDemo slot="lab" />}
  {chapter && <LinearAlgebraLab slot="lab" chapter={chapter} />}
  {entry.id === "matrix-rank" && <MatrixRankLab slot="lab" />}
  {courseModes[entry.id] && <CourseLab slot="lab" chapter={entry.id} mode={courseModes[entry.id]} name={entry.data.title} />}
  <Content /></ContentPage
>
