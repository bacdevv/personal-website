---
interface Props {
  heading?: "h2" | "h3";
  title: string;
  description: string;
  href: string;
  tags?: string[];
  label?: string;
  index?: number;
}
const {
  heading: Heading = "h2",
  title,
  description,
  href,
  tags = [],
  label = "Demo project",
  index = 1,
} = Astro.props;
---

<article class="entry-card">
  <div class="card-meta">
    <span>{String(index).padStart(2, "0")}</span><span>{label}</span>
  </div><Heading><a href={href}>{title}</a></Heading><p>{description}</p><div
    class="tags"
  >
    {tags.map(tag => <span class="tag">{tag}</span>)}
  </div>
</article>
