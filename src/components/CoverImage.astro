---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { readFileSync } from "node:fs";
interface Props {
  src: ImageMetadata | string;
  alt: string;
}
const { src, alt } = Astro.props;
let image:
  | { src: string; srcset: string; width: number; height: number }
  | undefined;
if (typeof src === "string") {
  try {
    image = JSON.parse(readFileSync(".cache/images.json", "utf8"))[src];
  } catch {}
}
---

{
  typeof src !== "string" ? (
    <Image
      {src}
      {alt}
      widths={[400, 760, 1200]}
      sizes="(max-width: 760px) 100vw, 760px"
      format="webp"
      loading="eager"
      class="cover"
    />
  ) : image ? (
    <img
      {...image}
      {alt}
      sizes="(max-width: 760px) 100vw, 760px"
      loading="eager"
      class="cover"
    />
  ) : (
    <img {src} {alt} width="1200" height="675" loading="eager" class="cover" />
  )
}
