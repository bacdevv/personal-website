---
import '../../styles/english-learning.css';
---
<figure class="en-diagram">
  <svg viewBox="0 0 640 200" role="img" aria-labelledby="en-place-title en-place-desc">
    <title id="en-place-title">At, on and in for places</title>
    <desc id="en-place-desc">At is a point marked beside a bus stop. On places a book on a shelf. In places a bag inside a room.</desc>
    <g class="place-scene" transform="translate(10 4)">
      <path d="M36 150V68 M24 68H89V96H24Z" fill="none" stroke="currentColor" stroke-width="3" />
      <path d="M22 161H167" stroke="currentColor" stroke-width="2" opacity=".4" />
      <circle cx="122" cy="138" r="8" fill="var(--en-accent)" />
      <text x="10" y="23" class="en-svg-label">AT · a point</text>
      <text x="61" y="189" class="en-svg-small">at the bus stop</text>
    </g>
    <g class="place-scene" transform="translate(215 4)">
      <path d="M18 152H172" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
      <rect x="76" y="88" width="52" height="61" rx="3" fill="none" stroke="var(--en-accent)" stroke-width="3" />
      <path d="M85 105H119 M85 118H117" stroke="currentColor" stroke-width="2" opacity=".5" />
      <text x="10" y="23" class="en-svg-label">ON · a surface</text>
      <text x="43" y="189" class="en-svg-small">on the shelf</text>
    </g>
    <g class="place-scene" transform="translate(427 4)">
      <rect x="26" y="64" width="123" height="105" rx="3" fill="none" stroke="currentColor" stroke-width="3" />
      <rect x="57" y="120" width="65" height="43" rx="3" fill="none" stroke="var(--en-accent)" stroke-width="3" />
      <path d="M79 120V110Q90 95 101 110V120" stroke="var(--en-accent)" stroke-width="3" fill="none" />
      <text x="8" y="23" class="en-svg-label">IN · inside</text>
      <text x="33" y="189" class="en-svg-small">in the room</text>
    </g>
  </svg>
  <figcaption>Place: a point, a surface, or an inside space.</figcaption>
</figure>
