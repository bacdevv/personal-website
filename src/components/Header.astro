---
import { profile } from "@/site";
const links = [
  ["/", "Home"],
  ["/about", "About"],
  ["/projects", "Projects"],
  ["/blog", "Blog"],
  ["/notes", "Notes"],
  ["/research", "Research"],
];
const active = (href: string) =>
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="site-width header-inner">
    <a href="/" class="brand" aria-label={`${profile.handle} home`}
      ><span class="monogram" aria-hidden="true">{profile.initials}</span><span
        >{profile.handle}<span style="color:var(--accent)"> /</span></span
      ></a
    >
    <nav class="desktop-nav" aria-label="Main navigation">
      {
        links.map(([href, label]) => (
          <a href={href} aria-current={active(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <a class="icon-button" href="/search" aria-label="Search the website"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"
          ></path></svg
        ></a
      ><button id="theme-btn" class="icon-button" aria-label="Switch theme"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><path d="M20 14a8 8 0 0 1-10-10 8 8 0 1 0 10 10Z"></path></svg
        ></button>
    </div>
  </div><details class="mobile-menu site-width">
    <summary>Menu</summary><nav aria-label="Mobile navigation">
      {
        [...links, ["/contact", "Contact"]].map(([href, label]) => (
          <a href={href} aria-current={active(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </details>
</header>
