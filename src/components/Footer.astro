---
import { profile } from "@/site";
interface Props {
  noMarginTop?: boolean;
}
---

<footer class="site-footer">
  <div class="site-width footer-inner">
    <p>
      © {new Date().getFullYear()}
      {profile.name}. Built with <a
        href="https://github.com/satnaing/astro-paper">AstroPaper</a
      >.
    </p><nav aria-label="Footer">
      <a href={profile.github}>GitHub</a><a href="/rss.xml">RSS</a><a
        href="/contact">Contact</a>
    </nav>
  </div>
</footer>
