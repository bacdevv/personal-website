---
import Socials from "./Socials.astro";
import { profile } from "@/site";
interface Props { noMarginTop?: boolean }
const { noMarginTop = false } = Astro.props;
---
<footer class:list={["app-layout", "footer-main", { "mt-auto": !noMarginTop }]}>
  <div class="footer-bar">
    <Socials />
    <div class="footer-credit">Copyright © {new Date().getFullYear()} {profile.name}. All rights reserved.</div>
  </div>
</footer>
