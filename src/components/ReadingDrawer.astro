---
/** A small, closed-by-default, fixed right-side TOC and optional live demonstration. */
import type { MarkdownHeading } from "astro";
import TableOfContents from "@/components/TableOfContents.astro";
import "@/styles/study-reader.css";
interface Props { headings: MarkdownHeading[]; showDemo?: boolean }
const { headings, showDemo = false } = Astro.props;
const hasContents = headings.some(h => h.depth === 2 || h.depth === 3);
---
{(hasContents || showDemo) && (
  <div class="reading-tools" data-reading-tools data-state="closed" data-has-demo={showDemo ? "true" : "false"} data-pagefind-ignore>
    <nav class="reading-tools__rail" aria-label="Reading tools">
      {hasContents && <button type="button" class="reading-tools__launch" data-reading-trigger="contents" aria-expanded="false" aria-controls="reading-tools-panel" title="Open table of contents">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg><span>Contents</span>
      </button>}
      {showDemo && <button type="button" class="reading-tools__launch" data-reading-trigger="demo" aria-expanded="false" aria-controls="reading-tools-panel" title="Open interactive demo">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 19h16M5 16 11 5l5 8 3-5M5 9h.01M19 16h.01"/></svg><span>Live demo</span>
      </button>}
    </nav>
    <div class="reading-tools__shade" data-reading-shade hidden></div>
    <aside class="reading-tools__panel" id="reading-tools-panel" data-reading-panel aria-label="Reading tools" hidden>
      <header class="reading-tools__header">
        <div class="reading-tools__switches" aria-label="Choose reading tool">
          {hasContents && <button type="button" data-reading-switch="contents" aria-pressed="true">Contents</button>}
          {showDemo && <button type="button" data-reading-switch="demo" aria-pressed="false">Live demo</button>}
        </div>
        <button class="reading-tools__close" type="button" data-reading-close aria-label="Close reading tools" title="Close panel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </header>
      {hasContents && <div class="reading-tools__body" data-reading-view="contents"><TableOfContents {headings} /></div>}
      {showDemo && <div class="reading-tools__body" data-reading-view="demo" hidden><slot /></div>}
    </aside>
  </div>
)}
